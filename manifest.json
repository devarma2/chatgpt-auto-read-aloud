{
  "manifest_version": 3,
  "name": "ChatGPT Auto Read Aloud",
  "version": "1.0.6",
  "description": "Automatically opens the latest assistant message actions and activates Read aloud.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": { "default_title": "ChatGPT Auto Read Aloud", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
